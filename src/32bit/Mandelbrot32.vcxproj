  <!--
    Release only: shrink the linker output. The two helper tools (C#: tools\PostLinkStripper, tools\MiniPeLinker) are compiled
    on demand with the Roslyn compiler that ships with MSBuild, so no binaries are kept in the repository.
      1. PostLinkStripper: removes the debug data (.rdata$zzzdbg) using the map file  -> obj\Mandelbrot32.stripped.exe
      2. MiniPeLinker:     moves the imports behind the code, drops unused imports     -> build\32bit\Mandelbrot32.exe (final EXE)
  -->
  <PropertyGroup>
    <ToolsOut>$(RepoRoot)build\tools\</ToolsOut>
    <Csc>$(MSBuildToolsPath)\Roslyn\csc.exe</Csc>
  </PropertyGroup>
  <Target Name="BuildShrinkTools" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'"
          Inputs="$(RepoRoot)tools\PostLinkStripper\Program.cs;$(RepoRoot)tools\MiniPeLinker\Program.cs"
          Outputs="$(ToolsOut)PostLinkStripper.exe;$(ToolsOut)MiniPeLinker.exe">
    <MakeDir Directories="$(ToolsOut)" />
    <Exec Command="&quot;$(Csc)&quot; /nologo /target:exe /out:&quot;$(ToolsOut)PostLinkStripper.exe&quot; &quot;$(RepoRoot)tools\PostLinkStripper\Program.cs&quot;" />
    <Exec Command="&quot;$(Csc)&quot; /nologo /target:exe /out:&quot;$(ToolsOut)MiniPeLinker.exe&quot; &quot;$(RepoRoot)tools\MiniPeLinker\Program.cs&quot;" />
  </Target>
  <Target Name="ShrinkRelease32" AfterTargets="Build" DependsOnTargets="BuildShrinkTools" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <Exec Command="&quot;$(ToolsOut)PostLinkStripper.exe&quot; &quot;$(TargetPath)&quot; &quot;$(IntDir)$(TargetName).stripped.exe&quot; &quot;$(IntDir)$(TargetName).map&quot;" />
    <Exec Command="&quot;$(ToolsOut)MiniPeLinker.exe&quot; &quot;$(IntDir)$(TargetName).stripped.exe&quot; &quot;$(RepoRoot)build\32bit\$(TargetName).exe&quot; &quot;$(RepoRoot)tools\MiniPeLinker\imports.csv&quot;" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
	<Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
